<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
    android:orientation="vertical" android:background="@drawable/widget_background" android:padding="14dp">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_cover" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/widget_cover"
            android:clipToOutline="true" android:scaleType="centerCrop" android:src="@drawable/ic_notification" android:contentDescription="书籍封面"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="听页 · 让故事继续"
                android:textSize="16sp" android:textStyle="bold" android:textColor="#283C32" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_chapter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="从书架导入一本书" android:textSize="12sp" android:textColor="#536C60" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <TextView android:id="@+id/widget_timer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="点按继续收听" android:textSize="11sp" android:textColor="#536C60" android:maxLines="1" android:ellipsize="end"/>
        <ImageButton android:id="@+id/widget_previous" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/widget_previous"
            android:padding="10dp" android:background="@android:color/transparent" android:contentDescription="上一章"/>
        <ImageButton android:id="@+id/widget_play" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/widget_play"
            android:padding="10dp" android:background="@drawable/widget_button" android:contentDescription="播放"/>
        <ImageButton android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/widget_next"
            android:padding="10dp" android:background="@android:color/transparent" android:contentDescription="下一章"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
