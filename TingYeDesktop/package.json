{
  "name": "tingye-aligner",
  "productName": "听页听读工坊",
  "version": "1.4.0",
  "description": "本地 GPU 逐句听读对齐工具",
  "author": "TingYe",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build --configLoader runner",
    "start": "electron .",
    "test": "python -c \"import sys,unittest;sys.path.insert(0,'engine');result=unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.discover('engine/tests'));sys.exit(not result.wasSuccessful())\"",
    "pack": "npm run build && electron-builder --win --dir --x64 --publish never",
    "installer": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "node --test electron/environment-store.test.cjs electron/environment-paths.test.cjs electron/history-store.test.cjs electron/app-data.test.cjs"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.tingye.aligner",
    "productName": "听页听读工坊",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "licenses/**/*",
      "package.json",
      "!node_modules/**/*",
      "!electron/**/*.test.cjs"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*.py",
          "!tests/**/*",
          "requirements.txt"
        ]
      },
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.ps1"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "TingYe-Aligner-${version}-Setup.${ext}"
    }
  }
}
