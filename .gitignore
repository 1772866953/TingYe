# Local signing material and credentials.
/signing/*
!/signing/README.md
!/signing/release.properties.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
keystore.properties
release.properties
*signing*.properties
.env
.env.*
!.env.example

