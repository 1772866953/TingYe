/.build-cache/
/tools/
/releases/
/archive/
/work/
/qa/fixtures/
/qa/results/
/qa/*.log
*.apk
*.aab
*.apks
*.hprof
*.log
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

